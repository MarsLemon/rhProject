{
  "name": "rh-project",
  "private": true,
  "type": "module",
  "description": "rhProject monorepo workspace scripts",
  "scripts": {
    "verify:chinese": "node scripts/chinese-encoding/verify-chinese-encoding.mjs",
    "scan:chinese": "node scripts/chinese-encoding/scan-all-encoding-report.mjs",
    "fix:encoding": "node scripts/chinese-encoding/fix-all-encoding.mjs",
    "repair:chinese-from-v2": "node scripts/chinese-encoding/repair-chinese-encoding.mjs",
    "sync:wiki": "node scripts/sync-cursor-wiki-index.mjs",
    "verify:wiki-index": "node scripts/verify-wiki-index.mjs",
    "sync:wiki:scheduled": ".cursor\\scheduled-tasks\\tasks\\sync-wiki.cmd",
    "audit:skills": "node scripts/audit-cursor-skills.mjs",
