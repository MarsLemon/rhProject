    "scan:chinese:scheduled": ".cursor\\scheduled-tasks\\tasks\\scan-chinese.cmd",
    "prune:logs:scheduled": ".cursor\\scheduled-tasks\\tasks\\prune-logs.cmd",
    "register:scheduled-tasks": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/scheduled-tasks/register.ps1",
    "register:sync-wiki-task": "powershell -NoProfile -ExresecutionPolicy Bypass -File .cursor/scheduled-tasks/register-wiki-only.ps1",
