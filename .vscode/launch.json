{
    "configurations": [
        {
            "command": "npm start",
            "name": "前端",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/wk-train-center-ui"
        },
        {
            "type": "java",
            "name": "后端(调试)",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.yf.web.WebApplication",
            "projectName": "yf-web",
            "args": "",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "-XX:ErrorFile=logs/jvm/app_hs_err_%p.log -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=logs/jvm"
        }
    ]
}