# 从后台「系统管理 → 存储配置 → 阿里云」逐项复制（字段名与 OssConfig JSON 一致）

endpoint=oss-cn-hangzhou

bucket=your-bucket

accessKeyId=

accessKeySecret=


# 对应后台「访问URL」（OssConfig.accelerate）；公开桶、私有桶都填这项，不是 url
# - security=public：表格里 Object.Key 的直连 URL 会用这个加速域名
# - security=private：此项会被忽略，所有直连走签名 URL（私有桶直连必然 403）

accelerate=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/


# 桶类型：public（默认，直连）/ private（强制走签名 URL 预览）
# 大小写不敏感，未知值退化为 public

security=public


# 占位字段（与主项目 OssConfig 对齐，本工具不接 STS 也不调授权接口，留空即可）

arn=

url=


# 本工具专用：打开时默认浏览的前缀（按环境改，例如 AI-training/ 或 dev/AI-training/）

defaultPrefix=AI-training/


# 上传文件大小上限（字节）。默认 500MB = 524288000；超过会被 multer 拒收 400
# 常见值：100MB=104857600, 200MB=209715200, 1GB=1073741824

maxFileSize=524288000


# 本地 API 端口（Vite 5180 会把 /api 代理到这里）

PORT=8101
