# 从后台「系统管理 → 存储配置 → 阿里云」逐项复制（字段名与 OssConfig JSON 一致）

endpoint=oss-cn-hangzhou

bucket=your-bucket

accessKeyId=

accessKeySecret=



# 对应后台「访问URL」（OssConfig.accelerate）；公开桶、私有桶都填这项，不是 url

accelerate=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/



# 本工具专用：打开时默认浏览的前缀（按环境改，例如 AI-training/ 或 dev/AI-training/）

defaultPrefix=AI-training/



# 本地 API 端口（Vite 5180 会把 /api 代理到这里）

PORT=5179


