{
  "mcpServers": {
    "mysql": {
      "type": "stdio",
      "command": "python",
      "args": ["e:/rhProject/scripts/mysql_mcp_safe_wrapper.py"],
      "env": {
        "MYSQL_HOST": "${MYSQL_HOST}",
        "MYSQL_PORT": "${MYSQL_PORT}",
        "MYSQL_USER": "${MYSQL_USER}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}",
        "MYSQL_DATABASE": "${MYSQL_DATABASE}"
      }
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["--registry", "https://registry.npmjs.org", "chrome-devtools-mcp@1.2.0"]
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp@0.0.1a4"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@latest"],
      "env": {
        "FIRECRAWL_API_KEY": "__FIRECRAWL_KEY_REMOVED__"
      }
    },
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["tavily-mcp@0.2.15"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "DEFAULT_PARAMETERS": "${DEFAULT_PARAMETERS}"
      }
    },
    "apifox-mcp": {
      "url": "https://apifox.com/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer afxp_f5aa42jz6P3rMrA0FOT6WJlC5rrsg5IqCi4Q",
        "X-Apifox-Api-Version": "2025-09-01"
      }
    },
    "MiniMax": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "MiniMax-mcp"]
    }
  }
}