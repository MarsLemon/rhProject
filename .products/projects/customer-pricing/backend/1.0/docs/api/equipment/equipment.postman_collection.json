                "exec": ["pm.collectionVariables.set('name101', '测'.repeat(101));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "pm.test(\"code 非零（参数校验失败）\", function () { pm.expect(body.code).to.not.eql('00000000'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 异常 · 同分类下 name 重复 → 803120306",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"categoryId\":{{categoryId}},\"name\":\"主机柴油机\"}" },
            "url": { "raw": "{{baseUrl}}/web/equipment/add", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "add"] },
            "description": "异常：name 已存在（BR-EQ-10 同分类下精确唯一） → 期望 803120306 (EQUIPMENT_NAME_ALREADY_EXIST)"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
