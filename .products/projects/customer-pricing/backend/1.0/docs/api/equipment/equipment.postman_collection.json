            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/equipment/list?groupBy=category", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "list"], "query": [
              { "key": "groupBy", "value": "category" }
            ]},
