        {
          "name": "2.7 异常 · name 含特殊字符（SQL 注入样本）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"categoryId\":{{categoryId}},\"name\":\"'; DROP TABLE wk_equipment;--\"}" },
            "url": { "raw": "{{baseUrl}}/web/equipment/add", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "add"] },
            "description": "安全：name 含 SQL 注入尝试 → MyBatis-Plus 参数化查询应安全入库，期望 803120307 (EQUIPMENT_NAME_ILLEGAL) 或成功（依 IN-EQ-05 严格度）"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
