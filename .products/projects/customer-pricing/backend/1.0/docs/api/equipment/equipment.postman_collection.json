        {
          "name": "2.5 异常 · name 超 100 字符",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"categoryId\":{{categoryId}},\"name\":\"{{name101}}\"}" },
            "url": { "raw": "{{baseUrl}}/web/equipment/add", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "add"] },
            "description": "异常：name 101 字符超 @Size max=100 → 期望 code 非零"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
