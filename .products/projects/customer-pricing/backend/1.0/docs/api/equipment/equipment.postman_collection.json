    {
      "name": "3. 设备列表 · 三视图用例集",
      "item": [
        {
          "name": "3.1 正向 · 扁平列表（无过滤）",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/equipment/list?keyword=&categoryId=", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "list"], "query": [
              { "key": "keyword", "value": "" },
              { "key": "categoryId", "value": "" }
            ]},
            "description": "正向：keyword/categoryId 留空 → 返所有设备（含停用）扁平数组，按 code 升序"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test(\"code=00000000\", function () { pm.expect(body.code).to.eql('00000000'); });",
                "pm.test(\"返回数组\", function () { pm.expect(Array.isArray(body.data)).to.eql(true); });"
              ]
            }
          }]
        },
        {
          "name": "3.2 正向 · 按分类过滤",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/equipment/list?categoryId={{categoryId}}", "host": ["{{baseUrl}}"], "path": ["web", "equipment", "list"], "query": [
              { "key": "categoryId", "value": "{{categoryId}}" }
            ]},
            "description": "正向：按 categoryId 过滤 → 仅返回该分类下设备"
          },
          "event": [{
            "listen": "test",
            "script": {
