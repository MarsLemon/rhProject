    {
      "name": "1. pricing-param",
      "item": [
        {
          "name": "1.1 查询全部启用参数",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/pricing-param/list", "host": ["{{baseUrl}}"], "path": ["web", "pricing-param", "list"] },
            "description": "后台：全量启用参数列表（min_billable_hours/floor_enabled/hours_per_day）"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test(\"code=00000000\", function () { pm.expect(body.code).to.eql('00000000'); });",
                "pm.test(\"data 是数组\", function () { pm.expect(Array.isArray(body.data)).to.be.true; });",
                "pm.collectionVariables.set('paramId', body.data[0].id);"
              ]
            }
          }]
        },
        {
          "name": "1.2 按 paramKey 查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/web/pricing-param/get/min_billable_hours", "host": ["{{baseUrl}}"], "path": ["web", "pricing-param", "get", "min_billable_hours"] },
            "description": "按 paramKey 查询（白名单：min_billable_hours/floor_enabled/hours_per_day）"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                "var body = pm.response.json();",
                "pm.test(\"code=00000000\", function () { pm.expect(body.code).to.eql('00000000'); });",
                "pm.test(\"返回 paramKey\", function () { pm.expect(body.data.paramKey).to.eql('min_billable_hours'); });"
              ]
            }
          }]
        },
        {
          "name": "1.3 更新参数值",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"paramValue\":\"8\",\"remark\":\"最低计费工时(保底价按一份计 × 此值,默认 8h)\"}"
            },
            "url": { "raw": "{{baseUrl}}/web/pricing-param/update/{{paramId}}", "host": ["{{baseUrl}}"], "path": ["web", "pricing-param", "update", "{{paramId}}"] },
            "description": "按 id 更新 paramValue/remark；value_type 一致性由 Service 校验"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                "pm.test(\"code=00000000\", function () { pm.response.json().code === '00000000' ? pm.expect(true).to.be.true : pm.expect.fail(pm.response.text()); });"
              ]
            }
          }]
        }
      ]
    },
